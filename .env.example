# Telegram
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
# ID cua private channel storage, vi du -1001234567890
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
# Chuoi ngau nhien chi gom A-Z a-z 0-9 _ -, dung de xac thuc webhook
WEBHOOK_SECRET_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Nen dung key moi dang sb_secret_... (Settings -> API Keys)
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback neu project cu chua co secret key moi:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NVIDIA
NVIDIA_API_KEY=PASTE_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# AI settings
MAX_HISTORY_MESSAGES=16
MAX_TOKENS=2048
TEMPERATURE=0.5

# File/document settings
MAX_DOCUMENT_CHARS=30000
MAX_FILE_MB=20

# Video/audio settings
MAX_VIDEO_MB=20
MAX_VIDEO_SECONDS=120
VIDEO_FALLBACK_FRAMES=8
MAX_AUDIO_MB=20
MEDIA_REQUEST_TIMEOUT=180

# Web + weather
AUTO_WEB_SEARCH=true
AUTO_WEATHER=true
WEB_MAX_RESULTS=5
DEFAULT_WEATHER_CITY=

# /clear
CLEAR_SCREEN_MAX_MESSAGES=300
