# Telegram
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
# ID cua private channel storage, vi du -1001234567890
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
# Chuoi ngau nhien chi gom A-Z a-z 0-9 _ -, dung de xac thuc webhook
WEBHOOK_SECRET_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Nen dung key moi dang sb_secret_... (Settings -> API Keys)
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback neu project cu chua co secret key moi:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NVIDIA
NVIDIA_API_KEY=PASTE_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# AI settings
MAX_HISTORY_MESSAGES=16
MAX_TOKENS=2048
TEMPERATURE=0.5

# File/document settings
# Các giới hạn MB bên dưới chỉ dành cho bước tải về/phân tích bằng AI.
# File vẫn được copy vào Telegram Storage trước, kể cả khi lớn hơn các mức này.
MAX_DOCUMENT_CHARS=30000
MAX_FILE_MB=20

# Video/audio settings
MAX_VIDEO_MB=20
MAX_VIDEO_SECONDS=120
VIDEO_FALLBACK_FRAMES=8
MAX_AUDIO_MB=20
MEDIA_REQUEST_TIMEOUT=180

# Web + weather
AUTO_WEB_SEARCH=true
AUTO_WEATHER=true
WEB_MAX_RESULTS=5
DEFAULT_WEATHER_CITY=

# /clear
CLEAR_SCREEN_MAX_MESSAGES=300

# Notification Gateway (dành cho repository khác; không lộ Telegram token/chat ID)
# Dùng một key chung, hoặc ưu tiên các key riêng từng project ở GATEWAY_API_KEYS.
# Tạo secret ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
# GATEWAY_API_KEY=PASTE_LONG_RANDOM_KEY_HERE
# Định dạng: project_name:secret;other_project:other_secret
# GATEWAY_API_KEYS=fall_detection:REPLACE_WITH_RANDOM_SECRET
# Số người nhận tối đa để hạn chế timeout trên Vercel (quy mô lớn cần job queue)
GATEWAY_MAX_RECIPIENTS=1000
GATEWAY_MESSAGES_PER_SECOND=12

# Multimedia gateway: only needed when other repos send HTTPS media URLs.
# Comma-separated exact HTTPS hostnames, no scheme or paths; e.g. your storage/CDN.
# GATEWAY_MEDIA_ALLOWED_HOSTS=cdn.example.com,files.example.org
# Direct multipart upload has a fixed file limit of 3.5 MB (Vercel function body <= 4.5 MB).


# Phase 1: private Supabase Storage signed upload (no new Supabase project).
# Create a PRIVATE bucket of this name in Supabase Dashboard > Storage.
GATEWAY_TEMP_BUCKET=telegram-gateway-temp
# Unique secret for scheduled cleanup; Vercel Cron sends Authorization Bearer CRON_SECRET.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=PASTE_DIFFERENT_RANDOM_SECRET_HERE

# Auto weather bulletin (7:00-7:59 AM Vietnam time on Vercel Hobby).
# Specify one or more Telegram chat IDs after recipients start the bot.
# Only opt-in recipients; weather is separate from emergency alert subscribers.
DAILY_WEATHER_CHAT_IDS=123456789
# Choose either city or both coordinates. No need to give precise address.
DAILY_WEATHER_CITY=Ha Noi
# DAILY_WEATHER_LATITUDE=
# DAILY_WEATHER_LONGITUDE=
# DAILY_WEATHER_LABEL=
